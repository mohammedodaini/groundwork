# ---------------------------------------------------------------------------
# Groundwork configuration
# Copy to `.env`. The defaults below run the app fully offline with the `fake`
# providers - no API keys, no cost. Switch to real providers when you want
# real research.
# ---------------------------------------------------------------------------

# local | test | production. `production` requires API_KEY (see below).
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- providers -------------------------------------------------------------
# fake | anthropic | openai | openrouter | groq | ollama
LLM_PROVIDER=fake
# fake | tavily | brave | searxng
SEARCH_PROVIDER=fake

# --- real search options ---------------------------------------------------
# Tavily: best extraction quality, metered credits.
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...
# 'advanced' bills at ~2x 'basic'. Use basic while testing.
# TAVILY_SEARCH_DEPTH=basic
#
# Brave: documented JSON API with a free monthly tier.
# SEARCH_PROVIDER=brave
# BRAVE_API_KEY=BSA...
#
# SearXNG: an instance you run. No key, no account, no per-query cost.
# The instance must list `json` under `search.formats` in its settings.yml,
# or every query returns 403.
# SEARCH_PROVIDER=searxng
# SEARXNG_BASE_URL=http://localhost:8888

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# TAVILY_API_KEY=tvly-...

# --- free / low-cost model options -----------------------------------------
# OpenRouter routes one API to many models, including free ones (`:free`
# suffix). Free models are rate-limited and the catalogue rotates, so pick a
# current one from https://openrouter.ai/models?q=free
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# Groq: free tier over open-weights models, very fast.
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile
#
# Ollama: fully local. No key, no network, no cost. Needs `ollama serve`.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
#
# Set both prices to 0.0 on a free tier so metrics do not report phantom spend.
# PRICE_PER_MTOK_INPUT_USD=0.0
# PRICE_PER_MTOK_OUTPUT_USD=0.0
#
# Points any OpenAI-compatible gateway (Together, vLLM, LM Studio) at itself.
# Overrides the provider default above.
# LLM_BASE_URL=https://your-gateway.example/v1

LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Used only to ESTIMATE run cost. Update when provider pricing changes.
PRICE_PER_MTOK_INPUT_USD=3.0
PRICE_PER_MTOK_OUTPUT_USD=15.0

# --- fetching --------------------------------------------------------------
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_CONCURRENCY=5

# --- persistence -----------------------------------------------------------
# SQLite by default so the app runs with no Docker.
DATABASE_URL=sqlite+aiosqlite:///./groundwork.db
# docker-compose sets:
# DATABASE_URL=postgresql+asyncpg://groundwork:<password>@localhost:5432/groundwork

# --- api -------------------------------------------------------------------
# If set, EVERY /api endpoint requires the X-API-Key header - the reads too,
# because past objectives and results are the sensitive data here. Leave blank
# locally; the app is frictionless with no key.
#
# REQUIRED when ENVIRONMENT=production: the app refuses to start without it
# rather than exposing an unauthenticated endpoint that spends money per call.
# API_KEY=change-me

# Browser origins allowed to call the API. The default suits local development
# and a deployment that serves the bundled UI from this same origin; set it
# explicitly when a separate frontend calls this API. JSON list syntax.
# CORS_ORIGINS=["https://app.example.com"]

RATE_LIMIT_PER_MINUTE=30

# Research runs allowed in flight at once. Each one spends LLM and search
# credits, so further requests get 429 with Retry-After until a slot frees up.
MAX_CONCURRENT_JOBS=4

# --- docker compose --------------------------------------------------------
# Required by docker-compose.yml, which refuses to start without it. Use a
# random, URL-safe value: it is embedded in the app's DATABASE_URL.
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
# POSTGRES_PASSWORD=

# Behind a reverse proxy, set this to the proxy's address so uvicorn trusts its
# X-Forwarded-For header and rate limiting sees real client addresses. Leave it
# unset otherwise: trusting forwarded headers from anyone lets every client
# choose its own IP, and with it its own rate-limit bucket.
# FORWARDED_ALLOW_IPS=172.18.0.1
